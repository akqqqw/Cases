{
  "name": "shelf-sort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "«Разложи по полкам» — casual puzzle (Sorting / Match-3)",
  "scripts": {
    "setup": "npm install",
    "start": "npm install --silent && vite --host 0.0.0.0 --port 5173",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:yandex": "vite build --base=./",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "tsc -b && vite build --base=./ && node scripts/package-yandex.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
